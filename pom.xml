<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.quarkiverse</groupId>
        <artifactId>quarkiverse-parent</artifactId>
        <version>25</version> <!-- always from repository -->
    </parent>

    <groupId>io.quarkiverse.opentelemetry.exporter</groupId>
    <artifactId>quarkus-opentelemetry-exporter-parent</artifactId>
    <version>999-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Quarkus Opentelemetry Exporter - Parent</name>

    <modules>
        <module>quarkus-opentelemetry-exporter-common</module>
        <module>quarkus-opentelemetry-exporter-azure</module>
        <module>quarkus-opentelemetry-exporter-gcp</module>
        <module>quarkus-opentelemetry-exporter-sentry</module>
    </modules>

    <scm>
        <connection>scm:git:git@github.com:quarkiverse/quarkus-opentelemetry-exporter.git</connection>
        <developerConnection>scm:git:git@github.com:quarkiverse/quarkus-opentelemetry-exporter.git</developerConnection>
        <url>https://github.com/quarkiverse/quarkus-opentelemetry-exporter</url>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <compiler-plugin.version>3.15.0</compiler-plugin.version>
        <maven.compiler.release>17</maven.compiler.release>

        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- On this block, library versions must be kept in sync with the ones in the quarkus-bom: -->
        <!-- Start-->
        <quarkus.version>3.40.1</quarkus.version>
        <netty-bom.version>4.1.138.Final</netty-bom.version>
        <opentelemetry-instrumentation-alpha.version>2.28.1-alpha</opentelemetry-instrumentation-alpha.version>
        <!-- End-->

        <gcp-opentelemetry.version>0.37.0</gcp-opentelemetry.version>
        <quarkus-google-cloud-services-bom.version>2.24.0</quarkus-google-cloud-services-bom.version>

        <quarkus-azure-services-bom.version>1.2.5</quarkus-azure-services-bom.version>
        <azure-monitor-opentelemetry-autoconfigure.version>1.6.0</azure-monitor-opentelemetry-autoconfigure.version>
        <!-- Keep aligned with the azure-core version pulled by azure-monitor-opentelemetry-autoconfigure;
             the version pinned by quarkus-azure-services-bom lags behind. -->
        <azure-core-http-vertx.version>1.1.7</azure-core-http-vertx.version>

        <sentry.version>8.59.0</sentry.version>

        <assertj-core.version>3.27.7</assertj-core.version>
        <testcontainers-junit-jupiter.version>1.21.4</testcontainers-junit-jupiter.version>
        <quarkus-wiremock-test.version>1.6.3</quarkus-wiremock-test.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- quarkus-azure-services-bom pins azure-core-http-vertx to 1.0.5 (built against azure-core 1.55 /
                 Vert.x 4.5.15), while the Azure exporter runs the azure-core shipped by
                 azure-monitor-opentelemetry-autoconfigure on the Vert.x of the Quarkus BOM. Align the transport with
                 the azure-core we actually run. Declared here (not in the azure BOM import) so that the
                 integration-tests module inherits it. -->
            <dependency>
                <groupId>com.azure</groupId>
                <artifactId>azure-core-http-vertx</artifactId>
                <version>${azure-core-http-vertx.version}</version>
            </dependency>
            <dependency>
                <groupId>io.quarkiverse.opentelemetry.exporter</groupId>
                <artifactId>quarkus-opentelemetry-exporter-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.quarkus</groupId>
                <artifactId>quarkus-bom</artifactId>
                <version>${quarkus.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.opentelemetry.instrumentation</groupId>
                <artifactId>opentelemetry-instrumentation-bom-alpha</artifactId>
                <version>${opentelemetry-instrumentation-alpha.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.quarkiverse.googlecloudservices</groupId>
                <artifactId>quarkus-google-cloud-services-bom</artifactId>
                <version>${quarkus-google-cloud-services-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>io.quarkus</groupId>
                    <artifactId>quarkus-maven-plugin</artifactId>
                    <version>${quarkus.version}</version>
                    <extensions>true</extensions>
                </plugin>
                <plugin>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${compiler-plugin.version}</version>
                    <configuration>
                        <compilerArgs>
                            <arg>-parameters</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>io.quarkus</groupId>
                    <artifactId>quarkus-config-doc-maven-plugin</artifactId>
                    <version>${quarkus.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <profile>
            <id>docs</id>
            <activation>
                <property>
                    <name>performRelease</name>
                    <value>!true</value>
                </property>
            </activation>
            <modules>
                <module>docs</module>
            </modules>
        </profile>
    </profiles>
</project>
